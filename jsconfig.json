{
    "compilerOptions": {
        "baseUrl": "./",
        "checkJs": false,
        "paths": {
            "@/*": ["src/*"],
            "@assets/*": ["src/assets/*"],
            "@icons/*": ["src/assets/icons/*"],
            "@comp/*": ["src/components/*"],
            "@config/*": ["src/config/*"],
            "@mod/*": ["src/modules/*"],
            "@pages/*": ["src/pages/*"],
            "@router/*": ["src/router/*"],
            "@store/*": ["src/store/*"],
            "@styles/*": ["src/styles/*"],
            "@utils/*": ["src/utils/*"]
        }
    },
    "exclude": ["dist"]
}
