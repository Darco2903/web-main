# With docker: SERVER_LISTEN=0.0.0.0, the published port is set in compose.yml
SERVER_LISTEN=0.0.0.0
SERVER_PORT=8080

# Paths are relative to the root folder or absolute
SSL_KEY_PATH=ssl/key.pem
SSL_CERT_PATH=ssl/cert.pem
SSL_CA_PATH=ssl/ca.pem

# Optional: "true" only behind a proxy that sets CF-Connecting-IP / X-Forwarded-For, defaults to false
# TRUST_PROXY=true

# Server origins (URL or bare host, https:// is assumed)
SERVER_ORIGIN=https://example.com
AUTH_SERVER_ORIGIN=https://auth.example.com
CDN_SERVER_ORIGIN=https://cdn.example.com
MANAGER_SERVER_ORIGIN=https://manager.example.com
ALTV_SERVER_ORIGIN=https://altv-web.example.com
